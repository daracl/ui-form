{
  "name": "@daracl/form",
  "version": "0.0.22",
  "sideEffects": false,
  "description": "Daracl form validation ",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/form",
    "daraclValidation",
    "daracl-validation",
    "daraclForm",
    "daracl-form",
    "form",
    "validation",
    "darainfo",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/daracl/ui-form",
  "bugs": {
    "url": "https://github.com/daracl/ui-form/issues",
    "email": "darainfosys@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-form.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.form.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "peerDependencies": {
    "@daracl/core": "^0.0.12",
    "@daracl/toast": "^0.0.10",
    "@daracl/datetimepicker": "^0.0.13"
  },
  "dependencies": {
    "@daracl/ui-style": "^0.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@daracl/core": "0.0.12",
    "@daracl/toast": "^0.0.10",
    "@daracl/datetimepicker": "^0.0.13",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^2.8.8",
    "sass": "^1.107.0",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "rollup": "^4.66.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:umd": "node scripts/build.mjs umd",
    "build:escjs": "node scripts/build.mjs es",
    "mergenclean": "npm run copy-dts && npm run build:tsc && npm run copy-unmin && npm run clean:unmin && npm run copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npm run build:tsc",
    "test": "node --test test/*.test.cjs",
    "pwtest": "playwright test",
    "clean:unmin": "node scripts/build-files.mjs clean-unmin",
    "copy-html": "node scripts/build-files.mjs html",
    "copy-unmin": "node scripts/build-files.mjs unmin",
    "copy-dts": "node scripts/build-files.mjs dts",
    "prepublishOnly": "npm run build",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node scripts/package-smoke.mjs",
    "audit:security": "npm audit --omit=dev",
    "audit:security:all": "npm audit"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "overrides": {
    "@daracl/core": "$@daracl/core",
    "esbuild": "$esbuild"
  }
}
