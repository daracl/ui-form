{
  "name": "@daracl/form",
  "version": "0.0.18",
  "sideEffects": false,
  "description": "Daracl form validation ",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/form",
    "daraclValidation",
    "daracl-validation",
    "daraclForm",
    "daracl-form",
    "form",
    "validation",
    "darainfo",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/daracl/ui-form",
  "bugs": {
    "url": "https://github.com/daracl/ui-form/issues",
    "email": "darainfosys@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-form.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.form.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "peerDependencies": {
    "@daracl/core": "^0.0.3",
    "@daracl/toast": "^0.0.10",
    "@daracl/datetimepicker": "^0.0.13"
  },
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "preact": "^10.13.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "devDependencies": {
    "@daracl/core": "^0.0.5",
    "@daracl/toast": "^0.0.10",
    "@daracl/datetimepicker": "^0.0.13",
    "@mxssfd/typedoc-theme": "^1.1.1",
    "@types/jest": "^29.5.1",
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "cpx": "^1.5.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "jest": "^29.0.0",
    "material-icons": "^1.13.8",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^2.8.8",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.80.2",
    "sass-loader": "^16.0.2",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "typedoc": "^0.26.7",
    "typescript": "^5.1.6",
    "url-loader": "^4.1.1",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  },
  "scripts": {
    "build": "yarn build:escjs && yarn build:umd && yarn mergenclean",
    "build:umd": "vite build --config vite.config.umd.js --mode production && vite build --config vite.config.umd.js --mode development",
    "build:escjs": "vite build --config vite.config.js --mode production && vite build --config vite.config.js --mode development",
    "mergenclean": "yarn copy-dts && yarn build:tsc && yarn copy-unmin && yarn clean:unmin && yarn copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npx -p typescript tsc src/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "pwtest": "playwright test",
    "clean:unmin": "rimraf dist/unmin",
    "copy-html": "cpx \"public/index.html\" dist",
    "copy-unmin": "cpx \"dist/unmin/**.*\" dist",
    "copy-dts": "cpx \"src/**/*.d.ts\" dist",
    "prepublishOnly": "npm run build"
  }
}
